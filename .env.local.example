# Copy this file to .env.local and fill in your own Supabase project values.
# Find these in your Supabase project: Settings > API.
#
# If you connect Supabase through the Vercel integration instead, it adds
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY automatically —
# the app reads either naming, so you don't need both.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
